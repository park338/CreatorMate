# DeepSeek API Key (OpenAI 兼容协议)
DEEPSEEK_API_KEY=your_key_here
# 可选:自定义 base_url,默认为 DeepSeek 官方
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型选择
DEEPSEEK_MODEL=deepseek-chat
# 仅用于账号五维诊断，其他功能继续使用上面的模型
DEEPSEEK_DIAGNOSE_MODEL=deepseek-reasoner

# 可选:火山引擎方舟生图。不配置时创作功能仍可运行,但不会生成 AI 封面图
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=doubao-seedream-5-0-260128
VOLCENGINE_IMAGE_SIZE=2K
